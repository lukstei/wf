{
	"name": "@lukstei/wf",
	"version": "0.1.1",
	"description": "Deterministic skill workflow runner for AI agents",
	"license": "MIT",
	"author": "Lukas Steinbrecher",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lukstei/wf.git"
	},
	"bugs": {
		"url": "https://github.com/lukstei/wf/issues"
	},
	"homepage": "https://github.com/lukstei/wf#readme",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"hooks",
		"skills",
		"rules",
		".claude-plugin",
		".codex-plugin",
		".agents",
		"AGENTS.md",
		"README.md",
		"plugin.json"
	],
	"bin": {
		"wf": "dist/wf.cjs"
	},
	"scripts": {
		"build": "node esbuild.config.js",
		"typecheck": "tsc --noEmit",
		"check": "biome check --write",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:update": "vitest run -u",
		"verify": "npm run test && npm run typecheck"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@types/node": "^22.20.3",
		"esbuild": "^0.28.2",
		"typescript": "^7.0.2",
		"vitest": "^3.0.0"
	},
	"dependencies": {
		"mdast-util-from-markdown": "^2.0.3"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"fsevents@2.3.3": true
	}
}
